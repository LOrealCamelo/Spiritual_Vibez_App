# AuraMystic Backend Environment Configuration
PORT=8000
AURAMYSTIC_DB_PATH=backend/data/auramystic.db
STORE_URL=https://www.neurospicymystic.com

# Optional External LLM Keys (Built-in Esoteric Synthesis Engine runs automatically if unset)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server-only secrets. Copy to .env.local; never commit real values.
# neon deploy / neon env pull supply these once the CLI is authorized.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_NAMESPACE=spiritual_vibz

# Deliberately keep billing disabled until the coordinated launch is verified.
MEMBERSHIP_REQUIRED=false
PAYPAL_SUBSCRIPTIONS_ENABLED=false
MEMBERSHIP_PUBLIC_URL=https://app.neurospicymystic.com
MEMBERSHIP_SUPPORT_EMAIL=workwithloreal@gmail.com
PAYPAL_IPN_URL=https://spiritual-vibez-app.onrender.com/api/account/paypal/ipn

# New PayPal monthly/yearly SDK subscriptions. Use a matching REST-app ID/secret.
# The public SDK client ID supplied by the owner is the default in the service.
PAYPAL_API_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# The $60 hosted Buy Now button uses the verified classic IPN endpoint above.
PAYPAL_LIFETIME_ENABLED=false

# Stripe pricing table: all credentials/price mappings stay on the backend.
STRIPE_CHECKOUT_ENABLED=false
# Public values must come from the same account as the table, prices and secret key.
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICING_TABLE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTH_PRICE_ID=price_1UdJOJJLFxwakDjOkkkgfM7p
STRIPE_YEAR_PRICE_ID=price_1UdJi6JLFxwakDjOxl3QSEKa
STRIPE_LIFETIME_PRICE_ID=price_1UdJQnJLFxwakDjOdjVHLruu
